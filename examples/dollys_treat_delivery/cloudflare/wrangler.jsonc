{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogdb-dolly-demo-spike",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
